datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

enum Role {
  ADMIN
  MARKETING
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PublicationStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  PUBLISHED
  PARTIAL
  FAILED
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TIKTOK
}

enum PlatformStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  name                 String
  // Hash de credencial (p. ej. bcrypt/argon2, nunca texto plano).
  // Requerido: el Obj. 3 de tesis exige autenticación propia del backend.
  passwordHash         String
  role                 Role               @default(MARKETING)
  publications         Publication[]      @relation("UserPublications")
  approvedPublications Publication[]      @relation("PublicationApprovals")
  accounts             ConnectedAccount[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Publication {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation("UserPublications", fields: [userId], references: [id], onDelete: Cascade)
  originalPrompt String
  systemPrompt   String?
  modelText      String              @default("gpt-4o")
  modelMedia     String?
  tokensUsed     Int?
  // Opcionales: el DRAFT se crea con el prompt ANTES de generar copy/media
  // (flujo prompt-primero del dashboard).
  copy           String?
  mediaUrl       String?
  mediaType      MediaType           @default(IMAGE)
  status         PublicationStatus   @default(DRAFT)
  scheduledAt    DateTime?
  // Auditoría del human-in-the-loop: quién aprobó y cuándo.
  approvedBy     String?
  approvedByUser User?               @relation("PublicationApprovals", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  targets        PublicationTarget[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, status])
}

/// Credenciales OAuth por plataforma para publicar vía APIs oficiales.
/// Los tokens se guardan cifrados a nivel aplicación (nunca en claro).
model ConnectedAccount {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform          Platform
  externalAccountId String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, platform])
}

model PublicationTarget {
  id              String         @id @default(cuid())
  publicationId   String
  publication     Publication    @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  platform        Platform
  status          PlatformStatus @default(PENDING)
  externalPostId  String?
  externalPostUrl String?
  errorMessage    String?
  metrics         TargetMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publicationId, platform])
}

model TargetMetric {
  id                  String            @id @default(cuid())
  publicationTargetId String
  publicationTarget   PublicationTarget @relation(fields: [publicationTargetId], references: [id], onDelete: Cascade)
  impressions         Int               @default(0)
  likes               Int               @default(0)
  comments            Int               @default(0)
  shares              Int               @default(0)
  clicks              Int               @default(0)

  capturedAt DateTime @default(now())

  @@index([publicationTargetId, capturedAt])
}
