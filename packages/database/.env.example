# Local dev database — matches /compose.yaml (host port 5433, NOT 5432).
# Onboarding: `cp .env.example .env`, then `docker compose up -d` from the repo root.
DATABASE_URL="postgresql://username:password@localhost:5433/dbname"
# Seed local (SOLO dev): credenciales iniciales con hash argon2id real.
# El seed falla rápido sin ellas; register siempre crea MARKETING, así que
# este admin es el único bootstrap del rol ADMIN.
SEED_ADMIN_EMAIL="admin@postly.test"
SEED_ADMIN_PASSWORD="cambia-esta-clave"
SEED_MARKETING_PASSWORD="cambia-esta-clave"
