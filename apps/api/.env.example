PORT=3001

# Orígenes permitidos para el dashboard (CORS + cookies). Coma-separados.
WEB_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=86400
# Cifrado AES-256-GCM de tokens OAuth (64 hex chars). Generar con:
# openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key
# Auth máquina-a-máquina para n8n (header x-api-key). Generar con:
# openssl rand -hex 32
N8N_API_KEY=your_n8n_api_key
# URL del nodo Webhook de n8n que despierta el dispatch inmediato (sin body).
# Desarrollo: Test URL (requiere "Listen for test event"); despliegue: Production URL.
N8N_DISPATCH_WEBHOOK_URL=url_webhook
# Secreto del Header Auth del nodo Webhook (header x-webhook-secret).
INTERNAL_WEBHOOK_SECRET=key_webhook
# Gemini (Google AI Studio) - solo backend. Free tier.
# La key real va en apps/api/.env (ignorado por git); aquí solo el placeholder.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=your_model_gemini
GEMINI_TEXT_FALLBACK_MODEL=your_model_gemini