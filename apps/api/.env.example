PORT=3001

# Orígenes permitidos para el dashboard (CORS + cookies). Coma-separados.
WEB_ORIGIN=http://localhost:3000

# Access JWT corto (cookie HttpOnly) + refresh opaco (cookie HttpOnly).
# El refresh NO es un JWT: se guarda hasheado en BD y se rota en cada uso.
# JWT_REFRESH_EXPIRES_IN_SECONDS es el TTL de la sesión (default 7 días).
JWT_ACCESS_SECRET=your_access_token_secret
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
# Cifrado AES-256-GCM de tokens OAuth (64 hex chars). Generar con:
# openssl rand -hex 32
ENCRYPTION_KEY=your_encryption_key
# Auth máquina-a-máquina para n8n (header x-api-key). Generar con:
# openssl rand -hex 32
N8N_API_KEY=your_n8n_api_key
# URL del nodo Webhook de n8n que despierta el dispatch inmediato (sin body).
# Desarrollo: Test URL (requiere "Listen for test event"); despliegue: Production URL.
N8N_DISPATCH_WEBHOOK_URL=url_webhook
# Secreto del Header Auth del nodo Webhook (header x-webhook-secret).
INTERNAL_WEBHOOK_SECRET=key_webhook
# Gemini (Google AI Studio) - solo backend. Free tier.
# La key real va en apps/api/.env (ignorado por git); aquí solo el placeholder.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_TEXT_MODEL=your_model_gemini
GEMINI_TEXT_FALLBACK_MODEL=your_model_gemini

# fal.ai (modo agente: imagen/video). Sin FAL_KEY el endpoint responde 503
# FAL_NOT_CONFIGURED y no llama a la red.
FAL_KEY=your_fal_key
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_VIDEO_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video
# Opcionales (defaults pensados para producción; los tests los achican).
# FAL_POLL_INTERVAL_MS=2000
# FAL_TIMEOUT_MS=240000

# Cloudflare R2 (copia de la media generada). El bucket debe exponerse público
# (r2.dev o dominio propio) y R2_PUBLIC_BASE_URL apunta a esa base.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=postly-media
R2_PUBLIC_BASE_URL=https://media.example.com

# OAuth de Meta (Facebook Login for Business) para vincular páginas de
# Facebook e Instagram. Sin estas variables el API arranca igual y los
# endpoints de conexión responden 503 META_OAUTH_NOT_CONFIGURED.
# La app y sus credenciales se crean en developers.facebook.com.
#
# Para conectar una cuenta real:
# - App tipo Business con Facebook Login for Business e Instagram.
# - App en Live + Business Verification + Advanced Access (App Review) de
#   pages_show_list, pages_read_engagement, pages_manage_posts,
#   instagram_basic e instagram_content_publish. En Development solo
#   funcionan las cuentas con rol en la app.
# - Redirect URI registrado EXACTO. En Live debe ser HTTPS; localhost solo
#   se acepta en Development.
# - Página con tareas MANAGE/CREATE_CONTENT (o PROFILE_PLUS_*) e Instagram
#   profesional vinculado. Si el rol viene de Business Manager, Meta exige
#   además ads_read o ads_management para publicar en Instagram.
# - PPA y 2FA del usuario pueden impedir la publicación.
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Debe coincidir EXACTO con el redirect URI registrado en el panel de Meta.
META_OAUTH_REDIRECT_URI=http://localhost:3001/api/connected-accounts/meta/oauth/callback
# Configuración de Facebook Login for Business de tipo "User access token"
# (no System user) que incluya las Pages/IG y los permisos. Si se define, el
# diálogo usa config_id y no envía scope; si se omite, usa META_OAUTH_SCOPES.
META_OAUTH_CONFIG_ID=
# URL absoluta del dashboard a la que se vuelve tras el callback.
WEB_APP_URL=http://localhost:3000
# Opcionales: versión de Graph y permisos separados por coma (solo sin
# config_id). v25.0 sigue soportada hasta 2028-07-29; v26.0 es la última.
# META_GRAPH_VERSION=v25.0
# META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# Nota: appsecret_proof no está implementado. Deja "Require App Secret"
# desactivado en Meta o las llamadas fallarán (también las de n8n).
